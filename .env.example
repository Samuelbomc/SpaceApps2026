# Solo para descargas protegidas. POWER y búsqueda CMR no requieren login.
# Configurar en el entorno; la CLI no carga automáticamente este archivo.
EARTHDATA_TOKEN=
# Alternativa al token:
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# PostgreSQL local. Cambiar estas credenciales antes de desplegar.
POSTGRES_USER=agrogeo
POSTGRES_DB=agrogeo
POSTGRES_PASSWORD=agrogeo_dev
DATABASE_URL=postgresql://agrogeo:agrogeo_dev@localhost:5432/agrogeo
REGION_ID=antioquia-reference
REGION_NAME="Medellín · referencia técnica"
REGION_LATITUDE=6.2442
REGION_LONGITUDE=-75.5812
RECENT_OBSERVATION_DAYS=90
INGESTION_LAG_DAYS=3
SOURCE_FALLBACK_MAX_LAG_DAYS=5
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Proxy de desarrollo Angular; el navegador utiliza /backend/*.
API_INTERNAL_URL=http://127.0.0.1:8000

# Datos privados locales; usar true para la cookie cuando el frontend sirva por HTTPS.
AUTH_COOKIE_SECURE=false
FARM_UPLOAD_DIRECTORY=data/farms

# Compose usa MongoDB por defecto. Sin Docker, Settings usa el adapter PostgreSQL.
# Para MongoDB local: RESULTS_BACKEND=mongodb y MONGODB_URI=mongodb://127.0.0.1:27017
# No configurar una URI localhost para los contenedores: allí el host es mongo.
RESULTS_BACKEND=mongodb
MONGODB_DATABASE=agrogeo
DATASET_DIRECTORY=data/datasets
MODEL_DIRECTORY=data/models
# Tablas procesadas para entrenamiento; configuración versionada si no hay override.
TRAINING_DATA_DIRECTORY=data/prepared/daily
TRAINING_CONFIG_PATH=
# Modelos recibidos del equipo y snapshots de variables procesadas, sin datos objetivo.
PRETRAINED_MODEL_DIRECTORY=ml/artifacts
FEATURE_DIRECTORY=data/features/daily-direct-v1
MODEL_SOURCE_DIRECTORY=data
# Presupuesto por intento para productos científicos; conserva descargas verificadas.
MODEL_DOWNLOAD_MAX_MB=128
NEAREST_INPUT_MAX_DISTANCE_KM=200
# Opcional: JSON RotationWaterRules revisado por cultivo/horizonte. Sin umbrales inventados.
ROTATION_WATER_RULES_PATH=
# Nombres aproximados del centro del mapa; servicio intercambiable compatible con Photon.
GEOCODER_URL=https://photon.komoot.io/reverse

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgroGeo DataQuery",
  "description": "Consulta compartida. Las fuentes temporales requieren start/end; SRTM solo puede omitir ambas.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "bbox": {
      "type": "array",
      "description": "[oeste, sur, este, norte]; el contrato Python valida oeste < este y sur < norte.",
      "prefixItems": [
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90},
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "start": {"type": "string", "format": "date"},
    "end": {"type": "string", "format": "date"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 20},
    "page_size": {"type": "integer", "minimum": 1, "maximum": 2000, "default": 100},
    "power_parameters": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}, "minItems": 1}
  },
  "oneOf": [
    {"required": ["latitude", "longitude"], "not": {"required": ["bbox"]}},
    {"required": ["bbox"], "not": {"anyOf": [{"required": ["latitude"]}, {"required": ["longitude"]}]}}
  ],
  "dependentRequired": {"start": ["end"], "end": ["start"]}
}
